# Donna AI Configuration
# Copy this file to .env and fill in your values

# ═══════════════════════════════════════════════════════════
# LLM PROVIDER (Choose ONE: AWS Bedrock OR OpenRouter)
# ═══════════════════════════════════════════════════════════

# Option 1: AWS Bedrock (Recommended - you're already using it)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# Option 2: OpenRouter (Alternative)
# OPENROUTER_API_KEY=your_openrouter_api_key
# OPENROUTER_MODEL=anthropic/claude-sonnet-4

# ═══════════════════════════════════════════════════════════
# REQUIRED: Nhost Database
# ═══════════════════════════════════════════════════════════
NHOST_GRAPHQL_ENDPOINT=https://yobugvzhlfuxviaptquw.hasura.ap-south-1.nhost.run/v1/graphql
NHOST_ADMIN_SECRET=your_nhost_admin_secret

# ═══════════════════════════════════════════════════════════
# REQUIRED: WhatsApp (Choose ONE method)
# ═══════════════════════════════════════════════════════════

# Option 1: n8n Webhook (RECOMMENDED - token managed in n8n)
N8N_SEND_WEBHOOK_URL=https://automation.sayf.in/webhook/whatsapp-send

# Option 2: Direct Meta API (fallback if n8n not set)
# WHATSAPP_PHONE_NUMBER_ID=806507515890557
# WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token

# ═══════════════════════════════════════════════════════════
# OPTIONAL: Pinecone Vector Memory
# ═══════════════════════════════════════════════════════════
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=donna-memory

# ═══════════════════════════════════════════════════════════
# OPTIONAL: Composio (Gmail/Calendar)
# ═══════════════════════════════════════════════════════════
COMPOSIO_API_KEY=your_composio_api_key
COMPOSIO_GMAIL_AUTH_CONFIG_ID=your_gmail_auth_config_id

# ═══════════════════════════════════════════════════════════
# OPTIONAL: Server Configuration
# ═══════════════════════════════════════════════════════════
DONNA_HOST=0.0.0.0
DONNA_PORT=8001
DONNA_CORS_ALLOW_ORIGINS=*
DONNA_ENABLE_DOCS=1
